{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aios://schemas/event.json",
  "title": "event",
  "description": "03 §Event。raw_ref 是唯一原始数据引用字段(03 Canonical naming rule);raw_data 不得进入标准 Event。",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number"
    },
    "raw_ref": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "timestamp",
    "source",
    "type",
    "content",
    "entities",
    "confidence",
    "raw_ref"
  ],
  "additionalProperties": false
}
