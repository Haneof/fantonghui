{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aios://schemas/entity.json",
  "title": "entity",
  "description": "03 §Entity + Q4 裁决:Relationship 独立成对象,Entity 只保存 relationship_ids。",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number"
        }
      },
      "required": [
        "confidence"
      ],
      "additionalProperties": false
    },
    "relationship_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "type",
    "identity",
    "relationship_ids",
    "evidence"
  ],
  "additionalProperties": false
}
