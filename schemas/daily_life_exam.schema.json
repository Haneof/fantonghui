{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.invalid/schemas/daily_life_exam.schema.json",
  "title": "AIOS synthetic person-day directional summary exam v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "persona",
    "cleaned_daily_stream",
    "directional_ground_truth"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^DAY_daily-examiner-01a0aa30_[0-9]{5}$"
    },
    "persona": {
      "$ref": "#/$defs/persona"
    },
    "cleaned_daily_stream": {
      "type": "array",
      "minItems": 140,
      "maxItems": 230,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "directional_ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_daily_summary",
        "dim:health",
        "dim:social",
        "dim:emotion",
        "dim:finance",
        "dim:career"
      ],
      "properties": {
        "global_daily_summary": {
          "$ref": "#/$defs/block"
        },
        "dim:health": {
          "$ref": "#/$defs/block"
        },
        "dim:social": {
          "$ref": "#/$defs/block"
        },
        "dim:emotion": {
          "$ref": "#/$defs/block"
        },
        "dim:finance": {
          "$ref": "#/$defs/block"
        },
        "dim:career": {
          "$ref": "#/$defs/block"
        }
      }
    }
  },
  "$defs": {
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "name",
        "synthetic",
        "age",
        "gender",
        "occupation",
        "city",
        "timezone",
        "date",
        "day_start",
        "day_end_exclusive",
        "day_type",
        "household_context",
        "interest",
        "contacts",
        "accounting_scope",
        "starting_context"
      ],
      "properties": {
        "person_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "const": true
        },
        "age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 90
        },
        "gender": {
          "enum": [
            "男",
            "女",
            "未指定"
          ]
        },
        "occupation": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "const": "Asia/Shanghai"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "day_start": {
          "type": "string",
          "format": "date-time"
        },
        "day_end_exclusive": {
          "type": "string",
          "format": "date-time"
        },
        "day_type": {
          "type": "string",
          "minLength": 1
        },
        "household_context": {
          "type": "string",
          "minLength": 1
        },
        "interest": {
          "type": "string",
          "minLength": 1
        },
        "contacts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "accounting_scope": {
          "type": "string",
          "minLength": 1
        },
        "starting_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task",
            "deliverable",
            "cash_balance_cents",
            "loan_principal_cents"
          ],
          "properties": {
            "task": {
              "type": "string",
              "minLength": 1
            },
            "deliverable": {
              "type": "string",
              "minLength": 1
            },
            "cash_balance_cents": {
              "type": "integer",
              "minimum": 0
            },
            "loan_principal_cents": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "timestamp",
        "end_timestamp",
        "modality",
        "speaker_or_source",
        "location",
        "content"
      ],
      "properties": {
        "slice_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "end_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "modality": {
          "enum": [
            "MIC",
            "APP",
            "SENSOR",
            "USER_NOTE"
          ]
        },
        "speaker_or_source": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "transaction": {
          "$ref": "#/$defs/transaction"
        },
        "measurements": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "amount_cents",
        "currency",
        "status",
        "category"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "amount_cents": {
          "type": "integer"
        },
        "currency": {
          "const": "CNY"
        },
        "status": {
          "const": "SETTLED"
        },
        "category": {
          "enum": [
            "ordinary_expense",
            "principal_repayment",
            "prior_work_income",
            "prior_purchase_refund",
            "home_repair",
            "new_loan_principal"
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "semantic_intent",
        "core_claim",
        "acceptable_directions",
        "required_entities",
        "evidence_slice_ids",
        "structured_anchors"
      ],
      "properties": {
        "anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_intent": {
          "type": "string",
          "minLength": 1
        },
        "core_claim": {
          "type": "string",
          "minLength": 1
        },
        "acceptable_directions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_slice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "structured_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value",
        "source_slice_id"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer"
        },
        "source_slice_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradicted_claim",
        "severity",
        "application_rule",
        "evidence_slice_ids"
      ],
      "properties": {
        "contradicted_claim": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "const": "VETO"
        },
        "application_rule": {
          "type": "string",
          "minLength": 1
        },
        "evidence_slice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "causal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "claim",
        "cause_evidence_slice_ids",
        "effect_evidence_slice_ids"
      ],
      "properties": {
        "relation": {
          "enum": [
            "EXPLICIT_SELF_ATTRIBUTION",
            "TEMPORAL_ASSOCIATION_NOT_DIAGNOSIS"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "cause_evidence_slice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effect_evidence_slice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_core_anchors",
        "redline_criteria",
        "grading_notes"
      ],
      "properties": {
        "semantic_core_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "redline_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/redline"
          }
        },
        "grading_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "causal_constraints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/causal"
          }
        }
      }
    }
  }
}
