{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aios://schemas/memory.json",
  "title": "memory",
  "description": "03 §Memory:事实层。AI 推断不得写入(03 绝对规则)。",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "RAW_LOG",
        "HOURLY",
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "QUARTERLY",
        "HALF_YEARLY",
        "YEARLY",
        "3YEAR"
      ]
    },
    "location": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "importance": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_memories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "timestamp",
    "level",
    "content",
    "importance"
  ],
  "additionalProperties": false,
  "x-note": "level 枚举来自宪法 6.4.3 九级周期压缩链"
}
